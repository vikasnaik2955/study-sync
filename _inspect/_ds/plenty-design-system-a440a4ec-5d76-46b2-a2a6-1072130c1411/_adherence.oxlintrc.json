        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:brand|food|clothes|neutral)$/]",
        "message": "<Chip> accent must be one of 'brand' | 'food' | 'clothes' | 'neutral'."
